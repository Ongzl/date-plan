# Copy this file to .env and paste your OpenCode API key
# (opencode.ai: Account > Personal API keys > Add API key)
OPENCODE_API_KEY=

# Optional. Lets the app check with Google whether a place takes bookings and find
# its real booking page (Google Cloud > APIs & Services: enable "Places API (New)").
# About 3-4 US cents per bookable stop. Without it, booking links are only load-checked.
GOOGLE_PLACES_API_KEY=
